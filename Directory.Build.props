<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <Version>1.0.0-rc.4</Version>
    <FileVersion>1.0.0.4</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>SpeedMeter Pro Project</Company>
    <Product>SpeedMeter Pro</Product>
    <Copyright>Copyright © 2026 SpeedMeter Pro Project</Copyright>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Automatically derive SourceRevisionId from Git HEAD if not explicitly provided -->
  <Target Name="DeriveSourceRevisionIdFromGit" BeforeTargets="GetAssemblyVersion;InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitSha" />
    </Exec>
    <PropertyGroup Condition="'$(GitCommitSha)' != ''">
      <SourceRevisionId>$(GitCommitSha.Trim())</SourceRevisionId>
      <InformationalVersion>$(Version)+$(GitCommitSha.Trim())</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
