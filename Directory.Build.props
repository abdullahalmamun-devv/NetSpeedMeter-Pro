<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <Version>1.0.0-rc.1</Version>
    <FileVersion>1.0.0.1</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0-rc.1+4a1c4f727dc9c0bb35bfe041df248955ab574b5b</InformationalVersion>
    <Company>SpeedMeter Pro Project</Company>
    <Product>SpeedMeter Pro</Product>
    <Copyright>Copyright © 2026 SpeedMeter Pro Project</Copyright>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
