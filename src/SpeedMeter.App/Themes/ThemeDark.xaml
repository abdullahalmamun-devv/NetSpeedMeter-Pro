<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1520" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#121B28" />
    <SolidColorBrush x:Key="PanelBrush" Color="#17202E" />
    <SolidColorBrush x:Key="PanelElevatedBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3B52" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1F2E42" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EFF4FB" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#243750" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2E4666" />
