<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelElevatedBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />

</ResourceDictionary>
