<Application x:Class="SpeedMeter.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#17202E" />
  <SolidColorBrush x:Key="MutedBrush" Color="#A8B6CA" />
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14" /></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#25354B" /><Setter Property="Foreground" Value="#F3F7FF" />
   <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="#40536C" />
   <Setter Property="Padding" Value="14,9" /><Setter Property="Margin" Value="0,0,8,0" />
   <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#17202E" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="8" /><Setter Property="MinHeight" Value="36" /></Style>
 </Application.Resources>
</Application>
