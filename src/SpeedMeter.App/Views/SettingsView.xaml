<UserControl x:Class="SpeedMeter.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">

            <!-- Page Header -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="{StaticResource FontSizeHero}" FontWeight="SemiBold" />
                    <TextBlock Text="Application preferences, appearance, data retention, and backup" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBodySmall}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- 1. Appearance & Units Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; Units" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Color Theme:" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Color theme">
                                <ComboBoxItem Content="Dark (Default)" Tag="Dark" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="System (Follows Windows)" Tag="System" />
                            </ComboBox>
                            <TextBlock Text="Light and System themes apply dynamically to all windows and widget surfaces."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rate Unit System:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <CheckBox Grid.Column="1" Content="Display rates in decimal bits/second (Mbps) instead of bytes/second (MB/s)" IsChecked="{Binding Bits}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Windows Startup:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <CheckBox Grid.Column="1" Content="Start SpeedMeter Pro automatically when Windows starts" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Monitoring & Sampling Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Monitoring &amp; Timezone" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sampling Interval:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1" SelectedValue="{Binding Interval}" SelectedValuePath="Tag" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Sampling interval">
                            <ComboBoxItem Content="0.5 seconds (High precision)" Tag="0.5" />
                            <ComboBoxItem Content="1.0 second (Standard default)" Tag="1.0" />
                            <ComboBoxItem Content="2.0 seconds (Low resource)" Tag="2.0" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Reporting Timezone:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTimezones}" SelectedItem="{Binding SelectedTimezoneId}" Width="320" HorizontalAlignment="Left" AutomationProperties.Name="Reporting timezone" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Billing Cycle Start Day:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding BillingCycleDay, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="Billing cycle start day" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Low-Resource / Battery:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <CheckBox Grid.Column="1" Content="Throttle UI refresh to 1 Hz to save power (byte accounting accuracy is preserved)" IsChecked="{Binding LowResourceMode}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Floating Widget Options Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Floating Widget Options" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Layout Style:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1" SelectedValue="{Binding WidgetLayout}" SelectedValuePath="Tag" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Widget layout style">
                            <ComboBoxItem Content="Minimal (Rates only)" Tag="Minimal" />
                            <ComboBoxItem Content="Compact Graph" Tag="CompactGraph" />
                            <ComboBoxItem Content="Detailed (Rates + Graph + Adapter)" Tag="Detailed" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Widget Opacity:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <DockPanel Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding WidgetOpacity, StringFormat='{}{0:P0}'}" Width="45" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Right" />
                            <Slider Minimum="0.2" Maximum="1.0" Value="{Binding WidgetOpacity}" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" Width="180" AutomationProperties.Name="Widget opacity" />
                        </DockPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,8">
                        <CheckBox Content="Always on Top (Topmost)" IsChecked="{Binding WidgetTopmost}" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="Enable Click-through (Clicks pass through; recoverable via tray icon or Ctrl+Shift+C)" IsChecked="{Binding WidgetClickThrough}" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="Dim widget opacity by 40% after 30 seconds of zero network activity" IsChecked="{Binding IdleDimmingEnabled}" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="Auto-hide widget when a fullscreen application or game is active" IsChecked="{Binding FullscreenAutoHideEnabled}" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Data Management & Retention Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Data Management &amp; Retention" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Retention Policy:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1" SelectedValue="{Binding DataRetentionDays}" SelectedValuePath="Tag" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Data retention policy">
                            <ComboBoxItem Content="Keep indefinitely (Default)" Tag="0" />
                            <ComboBoxItem Content="Retain 30 days" Tag="30" />
                            <ComboBoxItem Content="Retain 90 days" Tag="90" />
                            <ComboBoxItem Content="Retain 365 days (1 year)" Tag="365" />
                        </ComboBox>
                    </Grid>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Prune Older History" Command="{Binding PruneHistoryCommand}" Margin="0,0,10,0" />
                        <Button Content="Clear All Accounting History" Command="{Binding ClearAllHistoryCommand}" Background="#7F1D1D" Foreground="#FCA5A5" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 5. Configuration Export & Import Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Configuration Backup &amp; Transfer" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Export your settings, alert rules, and layout preferences to a versioned JSON file, or restore a previously saved configuration."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBodySmall}" Margin="0,0,0,14" />

                    <WrapPanel>
                        <Button Content="Export Configuration…" Command="{Binding ExportConfigCommand}" Margin="0,0,10,0" />
                        <Button Content="Import Configuration…" Command="{Binding ImportConfigCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 6. Updates Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="22" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Updates" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <CheckBox Content="Automatically check for SpeedMeter Pro updates" IsChecked="{Binding AutoUpdateCheckEnabled}" Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.Name="Automatically check for SpeedMeter Pro updates" />
                    <TextBlock Text="When enabled, checks GitHub at most once per day. GitHub can see your source IP and standard request headers. No package downloads automatically."
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBodySmall}" Margin="20,6,0,12" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8">
                        <Run Text="Current version: " /><Run Text="{Binding CurrentVersion, Mode=OneWay}" /><Run Text="    Channel: " /><Run Text="{Binding UpdateChannel, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding UpdateStatus.Message}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding UpdateSize}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}" Height="8" Margin="0,0,0,12" AutomationProperties.Name="Update download progress" />
                    <WrapPanel>
                        <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,8" />
                        <Button Content="Update now" Command="{Binding UpdateNowCommand}" IsEnabled="{Binding CanUpdateNow}" Margin="0,0,8,8" />
                        <Button Content="Later" Command="{Binding LaterCommand}" Margin="0,0,8,8" />
                        <Button Content="Release notes" Command="{Binding OpenReleaseNotesCommand}" IsEnabled="{Binding UpdateAvailable}" Margin="0,0,8,8" />
                        <Button Content="Cancel download" Command="{Binding CancelUpdateCommand}" IsEnabled="{Binding UpdateBusy}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 7. Action Buttons Bar -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="16,12">
                <DockPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource StatusSuccessBrush}" VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0" DockPanel.Dock="Right" TextWrapping="Wrap" />
                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Save Settings" Command="{Binding SaveCommand}" Width="120" />
                        <Button Content="Reset to Defaults" Command="{Binding ResetDefaultsCommand}" Width="140" />
                    </WrapPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
