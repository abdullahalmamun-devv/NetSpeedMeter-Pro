<UserControl x:Class="SpeedMeter.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- Page Header -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Usage &amp; History" FontSize="{StaticResource FontSizeHero}" FontWeight="SemiBold" />
                    <TextBlock Text="Audited half-open historical intervals and canonical byte totals" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBodySmall}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Period Selector Bar -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="16,12" Margin="0,0,0,18">
                <DockPanel>
                    <TextBlock Text="PERIOD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Today" Command="{Binding SelectPeriodCommand}" CommandParameter="Today" Width="80" Margin="0,0,6,0" />
                        <Button Content="Yesterday" Command="{Binding SelectPeriodCommand}" CommandParameter="Yesterday" Width="80" Margin="0,0,6,0" />
                        <Button Content="This Week" Command="{Binding SelectPeriodCommand}" CommandParameter="ThisWeek" Width="90" Margin="0,0,6,0" />
                        <Button Content="This Month" Command="{Binding SelectPeriodCommand}" CommandParameter="ThisMonth" Width="90" Margin="0,0,6,0" />
                        <Button Content="Billing Cycle" Command="{Binding SelectPeriodCommand}" CommandParameter="BillingCycle" Width="100" Margin="0,0,6,0" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Selected Range Summary Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding CoverageText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding RangeDescription}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Canonical half-open range [StartUtc, EndUtc) query" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Metrics Grid -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL RECORDED USAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalBytesText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DOWNLOAD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DownloadBrush}" />
                            <TextBlock Text="{Binding RxBytesText}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource DownloadBrush}" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UPLOAD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource UploadBrush}" />
                            <TextBlock Text="{Binding TxBytesText}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource UploadBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Direction Share Bar -->
                    <TextBlock Text="TRAFFIC DIRECTION RATIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Grid Height="8" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding RxPercent, StringFormat='{}{0}*'}" />
                            <ColumnDefinition Width="{Binding TxPercent, StringFormat='{}{0}*'}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource DownloadBrush}" CornerRadius="4,0,0,4" />
                        <Border Grid.Column="1" Background="{StaticResource UploadBrush}" CornerRadius="0,4,4,0" />
                    </Grid>
                    <DockPanel>
                        <TextBlock Text="{Binding RxPercent, StringFormat='Download: {0:F1}%'}" Foreground="{StaticResource DownloadBrush}" FontSize="11" />
                        <TextBlock Text="{Binding TxPercent, StringFormat='Upload: {0:F1}%'}" Foreground="{StaticResource UploadBrush}" HorizontalAlignment="Right" FontSize="11" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Export Toolbar -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="16,12" Margin="0,0,0,18">
                <DockPanel>
                    <TextBlock Text="{Binding ExportStatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0" DockPanel.Dock="Right" />
                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Width="100" />
                        <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Width="100" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Intervals Table Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Audited Intervals (Keyset Paged)" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubheading}" Margin="0,0,0,12" />

                    <ListView ItemsSource="{Binding Intervals}" MaxHeight="320" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Interval ID" Width="140" DisplayMemberBinding="{Binding IntervalId}" />
                                <GridViewColumn Header="Start UTC (ms)" Width="130" DisplayMemberBinding="{Binding StartUtcMs}" />
                                <GridViewColumn Header="End UTC (ms)" Width="130" DisplayMemberBinding="{Binding EndUtcMs}" />
                                <GridViewColumn Header="Rx Bytes" Width="110" DisplayMemberBinding="{Binding BytesRx}" />
                                <GridViewColumn Header="Tx Bytes" Width="110" DisplayMemberBinding="{Binding BytesTx}" />
                                <GridViewColumn Header="Gap?" Width="60" DisplayMemberBinding="{Binding IsGap}" />
                                <GridViewColumn Header="Confidence" Width="90" DisplayMemberBinding="{Binding TimingConfidence}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Button Content="Load Next 50 Intervals" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="{Binding HasMore, Converter={x:Null}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
