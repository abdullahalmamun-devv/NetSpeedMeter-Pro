<Window x:Class="SpeedMeter.App.Views.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpeedMeter.App"
        Title="SpeedMeter Pro · Quick Panel" Width="280" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="✕" Click="CloseClick" Padding="4,2" Margin="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" />
                <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="0,0,8,0" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectivityText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock Text="SpeedMeter Pro" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBodySmall}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Rates Grid -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="↓ DOWNLOAD" Foreground="{StaticResource DownloadBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding DownloadRateText}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="↑ UPLOAD" Foreground="{StaticResource UploadBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding UploadRateText}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Today & Scope -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="{Binding TodayUsageText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding ScopeText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Chart -->
            <Border Grid.Row="3" Background="#121B28" CornerRadius="4" Padding="4" Margin="0,0,0,10">
                <local:TrafficChart x:Name="Chart" Height="80" />
            </Border>

            <!-- Action Buttons -->
            <UniformGrid Grid.Row="4" Columns="2">
                <Button Content="{Binding IsPaused, Converter={x:Null}, FallbackValue='Pause'}" Command="{Binding TogglePauseCommand}" Margin="0,0,4,0" FontSize="11" Padding="8,4" />
                <Button Content="Dashboard" Command="{Binding OpenDashboardCommand}" Margin="4,0,0,0" FontSize="11" Padding="8,4" />
            </UniformGrid>
        </Grid>
    </Border>
</Window>
