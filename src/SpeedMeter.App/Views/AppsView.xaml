<UserControl x:Class="SpeedMeter.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24">

            <!-- Page Header -->
            <DockPanel Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Application Analytics" FontSize="{StaticResource FontSizeHero}" FontWeight="SemiBold" />
                    <TextBlock Text="Process-level network bandwidth attribution" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBodySmall}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Honest Status Card -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="28" Margin="0,0,0,20">
                <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                    <Border Background="#243750" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="FEATURE GATED TO V1.5" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </Border>

                    <TextBlock Text="Application traffic analytics is not available in V1" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="Standard-user Windows execution does not expose per-process socket attribution without elevated privileges or an inspected kernel filter driver. In strict accordance with the product charter, SpeedMeter Pro never fabricates processes, estimates app traffic from port numbers, or displays simulated application rows."
                               TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="What is working right now:" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Margin="0,0,0,8" />
                    <TextBlock Text="• Verified 64-bit integer adapter accounting on all active network interfaces" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,4" />
                    <TextBlock Text="• Dynamic route determination and fail-closed VPN traffic isolation" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,4" />
                    <TextBlock Text="• Durable SQLite WAL persistence, calendar billing cycles, and quota monitoring" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,4" />
                    <TextBlock Text="• Keyset-paged intervals and atomic CSV/JSON exports in Usage &amp; History" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,16" />

                    <TextBlock Text="ProcessIdentity research and least-privilege driver evaluation are tracked under milestone V1.5 (ADR-007)." FontSize="{StaticResource FontSizeBodySmall}" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
