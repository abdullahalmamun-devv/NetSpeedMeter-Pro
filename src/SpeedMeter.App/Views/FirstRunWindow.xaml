<Window x:Class="SpeedMeter.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to SpeedMeter Pro"
        Width="520" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource SurfaceCornerRadius}"
            Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Welcome to SpeedMeter Pro"
                           FontSize="{StaticResource FontSizeHeading}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Truthful, local-first network metering for Windows"
                           FontSize="{StaticResource FontSizeBodySmall}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Privacy Disclosures & Preferences -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <StackPanel>

                    <!-- Disclosure 1: Local-first -->
                    <Border Background="{StaticResource PanelElevatedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="16,12" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border Background="#10B981" CornerRadius="3" Padding="6,2" DockPanel.Dock="Right">
                                    <TextBlock Text="LOCAL-FIRST" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                                <TextBlock Text="Private &amp; Account-Free" FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </DockPanel>
                            <TextBlock Text="All traffic measurement, interval ledgers, and quota calculations run entirely on your local PC. No account is required and no telemetry is transmitted."
                                       TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBodySmall}" />
                        </StackPanel>
                    </Border>

                    <!-- Disclosure 2: Optional Active Checks -->
                    <Border Background="{StaticResource PanelElevatedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="16,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Optional Connection Checks" FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Periodic HTTPS reachability checks can verify internet uptime (every 30 seconds). By default, active checks are turned off to protect your privacy."
                                       TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBodySmall}" Margin="0,0,0,10" />

                            <CheckBox x:Name="EnableChecksCheckBox"
                                      Content="Enable periodic internet reachability checks (opt-in)"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Disclosure 3: Manual Public IP -->
                    <Border Background="{StaticResource PanelElevatedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="16,12" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Manual Public IP Tool" FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="When you manually run the Public IP lookup in Network Tools, it contacts an external service which can see your source IP. It is never invoked automatically."
                                       TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBodySmall}" />
                        </StackPanel>
                    </Border>

                    <!-- Quick Preferences -->
                    <TextBlock Text="PREFERENCES" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Theme Picker -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Theme" FontSize="{StaticResource FontSizeBodySmall}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="ThemePicker" SelectedIndex="0">
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="System" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Units Picker -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Display Units" FontSize="{StaticResource FontSizeBodySmall}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="UnitsPicker" SelectedIndex="0">
                                <ComboBoxItem Content="Mbps (Megabits/s)" />
                                <ComboBoxItem Content="MB/s (Megabytes/s)" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <DockPanel Grid.Row="2">
                <Button Content="Get Started"
                        Click="GetStartedClick"
                        Background="{StaticResource AccentBrush}"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        Padding="24,10"
                        HorizontalAlignment="Right" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
