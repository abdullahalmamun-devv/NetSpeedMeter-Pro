<Window x:Class="SpeedMeter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpeedMeter.App"
        xmlns:views="clr-namespace:SpeedMeter.App.Views"
        Title="SpeedMeter Pro" Width="1160" Height="780" MinWidth="900" MinHeight="620"
        Background="#0E1520" Foreground="#EFF4FB" FontFamily="{StaticResource SystemFontFamily}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Background="#121B28" BorderBrush="#1F2E42" BorderThickness="0,0,1,0" Padding="20,26,16,20">
            <DockPanel>
                <!-- Bottom Metadata & Settings -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="⚙  Settings" Click="NavSettingsClick" HorizontalAlignment="Stretch" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A8B6CA" />
                    <Separator Background="#2A3B52" Margin="0,8,0,14" />
                    <TextBlock Text="V1.0 PRODUCTION BUILD" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4" />
                    <TextBlock Text="Local-first · Account-free&#10;Audited integer accounting." Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="17" />
                </StackPanel>

                <!-- Navigation Header & Items -->
                <StackPanel>
                    <TextBlock Text="SPEEDMETER" FontWeight="Bold" FontSize="18" />
                    <TextBlock Text="PRO" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,32" />

                    <!-- 5 Primary Destinations (PRD §5.1) -->
                    <Button x:Name="NavOverviewBtn" Content="📊  Overview" Click="NavOverviewClick" HorizontalAlignment="Stretch" Margin="0,0,0,6" Background="#243750" HorizontalContentAlignment="Left" Padding="12,10" FontWeight="SemiBold" />
                    <Button x:Name="NavLiveTrafficBtn" Content="📈  Live Traffic" Click="NavLiveTrafficClick" HorizontalAlignment="Stretch" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A8B6CA" />
                    <Button x:Name="NavAppsBtn" Content="📱  Apps" Click="NavAppsClick" HorizontalAlignment="Stretch" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A8B6CA" />
                    <Button x:Name="NavHistoryBtn" Content="📅  Usage &amp; History" Click="NavHistoryClick" HorizontalAlignment="Stretch" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A8B6CA" />
                    <Button x:Name="NavToolsBtn" Content="🛠  Network Tools" Click="NavToolsClick" HorizontalAlignment="Stretch" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A8B6CA" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">

            <!-- 1. Overview Panel -->
            <ScrollViewer x:Name="OverviewPanel" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,24">
                    <!-- Top Bar -->
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Quick Panel" Click="OpenQuickPanelClick" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Show Widget" Click="ShowWidget" VerticalAlignment="Center" Margin="0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Overview" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="Live activity and today's persistent usage ledger." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" FontSize="13" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Scope Bar -->
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3B52" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshAdapters" Margin="10,0,0,0" />
                                <TextBlock Text="MEASUREMENT SCOPE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ComboBox x:Name="AdapterPicker" DisplayMemberPath="Label" SelectionChanged="AdapterChanged" AutomationProperties.Name="Measurement adapter" Margin="0,0,0,8" />
                            <TextBlock x:Name="ScopeDescription" Text="Dynamic route determination via AutoPrimary. Virtual tunnel traffic is strictly isolated." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Primary Rate Metrics -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Download Card -->
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#2A3B52" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="↓  DOWNLOAD" Foreground="{StaticResource DownloadBrush}" FontSize="12" FontWeight="Bold" />
                                <TextBlock x:Name="DownloadValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,6" AutomationProperties.Name="Download rate" />
                                <TextBlock x:Name="ReceivedValue" Text="Session received · 0 B" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- Upload Card -->
                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#2A3B52" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="↑  UPLOAD" Foreground="{StaticResource UploadBrush}" FontSize="12" FontWeight="Bold" />
                                <TextBlock x:Name="UploadValue" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,6" AutomationProperties.Name="Upload rate" />
                                <TextBlock x:Name="SentValue" Text="Session sent · 0 B" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Today Summary & Quota Cards Grid -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#2A3B52" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="TODAY'S USAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="TodayCoverageText" Text="Coverage: 100%" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </DockPanel>
                                <TextBlock x:Name="TodayTotalText" Text="0 B" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,6" />
                                <DockPanel>
                                    <TextBlock Text="Rx: " Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="TodayRxText" Text="0 B" Foreground="{StaticResource DownloadBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,12,0" />
                                    <TextBlock Text="Tx: " Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="TodayTxText" Text="0 B" Foreground="{StaticResource UploadBrush}" FontWeight="SemiBold" FontSize="12" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#2A3B52" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="BILLING CYCLE QUOTA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="QuotaBadgeText" Text="Active" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                </DockPanel>
                                <TextBlock x:Name="QuotaSummaryText" Text="Quota active" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,6" />
                                <ProgressBar x:Name="QuotaProgressBar" Value="0" Maximum="100" Margin="0,0,0,6" />
                                <TextBlock x:Name="QuotaRemainingText" Text="Remaining: —" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Chart Card -->
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#2A3B52" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="LAST 60 SECONDS" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="Live traffic" FontWeight="SemiBold" FontSize="16" />
                            </DockPanel>
                            <local:TrafficChart x:Name="Chart" Height="150" Margin="0,16,0,12"
                                                AutomationProperties.Name="Live traffic graph. Current values and session totals are shown as text above." />
                            <TextBlock x:Name="StatusText" Text="Choose an adapter to begin." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <!-- Controls Toolbar -->
                    <WrapPanel Margin="0,0,0,14">
                        <Button x:Name="PauseButton" Content="Pause" Click="TogglePause" />
                        <Button Content="Reset session" Click="ResetSession" />
                        <Button x:Name="UnitsButton" Content="Units: bytes/s" Click="ToggleUnits" />
                        <ComboBox x:Name="IntervalPicker" Width="110" SelectedIndex="1" SelectionChanged="IntervalChanged" AutomationProperties.Name="Sampling interval">
                            <ComboBoxItem Content="0.5 seconds" />
                            <ComboBoxItem Content="1 second" />
                            <ComboBoxItem Content="2 seconds" />
                        </ComboBox>
                    </WrapPanel>

                    <TextBlock x:Name="CoverageText" Text="Session coverage begins with the first valid interval." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                    <Button Content="Quit SpeedMeter Pro" Click="QuitClick" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 2. Live Traffic View -->
            <views:LiveTrafficView x:Name="LiveTrafficViewControl" Visibility="Collapsed" />

            <!-- 3. Apps View -->
            <views:AppsView x:Name="AppsViewControl" Visibility="Collapsed" />

            <!-- 4. History View -->
            <views:HistoryView x:Name="HistoryViewControl" Visibility="Collapsed" />

            <!-- 5. Network Tools View -->
            <views:NetworkToolsView x:Name="NetworkToolsViewControl" Visibility="Collapsed" />

            <!-- 6. Settings View -->
            <views:SettingsView x:Name="SettingsViewControl" Visibility="Collapsed" />

        </Grid>
    </Grid>
</Window>
