<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SpeedMeterPro-Setup</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SpeedMeter.Core/SpeedMeter.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PayloadZipPath)' != '' and Exists('$(PayloadZipPath)')">
    <EmbeddedResource Include="$(PayloadZipPath)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
